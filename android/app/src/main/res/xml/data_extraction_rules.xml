<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12+. See backup_rules.xml for why these are excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="settings.xml" />
        <exclude domain="sharedpref" path="packet_logs.xml" />
        <exclude domain="file" path="logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="settings.xml" />
        <exclude domain="sharedpref" path="packet_logs.xml" />
        <exclude domain="file" path="logs/" />
    </device-transfer>
</data-extraction-rules>
