<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower (auto backup / adb backup).
   "settings" holds the AirPods proximity keys (IRK, ENC_KEY), MAC address and
   serial numbers; the packet logs and collected logs can contain the same data.
   None of it may leave the device.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="settings.xml" />
    <exclude domain="sharedpref" path="packet_logs.xml" />
    <exclude domain="file" path="logs/" />
</full-backup-content>
